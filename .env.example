# Toolshop
TOOLSHOP_BASE_URL=http://localhost:8091
TOOLSHOP_USER_EMAIL=
TOOLSHOP_USER_PASSWORD=

# Proveedor OpenAI-compatible para Azure AI Evaluation.
# Copiar este archivo como .env y completar localmente. Nunca commitear .env.
EVAL_PROVIDER=openai_compatible
EVAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVAL_MODEL=gemini-2.5-flash-lite
EVAL_API_KEY=
PF_WORKER_COUNT=1

# Emulador local de rendimiento
TARGET_HOST=http://127.0.0.1:8000
TPM=34000
MAX_CONC=4
BASE_MS=250
MS_PER_TOK=8
LOAD_PROFILE=saturation
